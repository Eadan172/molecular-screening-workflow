# 留空则不调用大模型，直接运行计算并生成规则报告。
LLM_API_KEY=

# OpenAI 兼容接口，地址需要带 /v1。
# OpenAI:  https://api.openai.com/v1          模型 gpt-4o-mini
# DeepSeek: https://api.deepseek.com/v1       模型 deepseek-chat
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# Moonshot: https://api.moonshot.cn/v1        模型 moonshot-v1-8k
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 可选：Jev 只做证据门控、热门模态选择和下一步路由。
# 留空时跳过，不影响确定性计算。密钥在 https://jev-ai.org 获取。
JEV_API_KEY=
JEV_BASE_URL=https://jev-ai.org/api/v1
# 生产与评估建议固定版本；jev-latest 会随服务更新。
JEV_MODEL=jev-1.13
